#!/bin/sh
# render-manifest — render package/package-manifest.yaml for one leg.
#
#   tools/render-manifest <runtime-root> <runtime-ref> <version> <out-file>
#
# <runtime-root> is the root's DECLARED spelling (/__tfs__ POSIX, /t
# windows); the other placeholders come straight from versions.yaml via
# tools/pins.rb (the lock-row digests/versions arrive as ENV: the
# workflow sources pins.rb --env first). `created` is stamped here
# (RFC 3339 UTC). Every substitution source must be NON-EMPTY — a blank
# render is a named error, never a silent half-render.
set -eu

[ $# -eq 4 ] || { echo "usage: tools/render-manifest <runtime-root> <runtime-ref> <version> <out-file>" >&2; exit 64; }

root=$1
ref=$2
version=$3
out=$4
created=$(date -u +%Y-%m-%dT%H:%M:%SZ)

# The lock block's pins (spec 23 §4/§13.6 + spec 32 §6): the carried slice
# digests, the spawned java pair's identity + digests, and the spawned
# xml2rfc payload row's identity + digests (the provider image pin + the
# nested python pair), from versions.yaml via pins.rb. Fail-closed: each
# must be set and non-empty.
for var in MN_SHA256 JDK_LANG JDK_TEBAKO JDK_EXE_SHA256 JDK_SHA256 \
           X2RFC_VERSION X2RFC_SHA256 PY_LANG PY_TEBAKO PY_EXE_SHA256 PY_IMAGE_SHA256 RUNTIME_RUBY; do
    eval "val=\${$var:-}"
    if [ -z "$val" ]; then
        echo "render-manifest: \$$var is unset/empty (source tools/pins.rb first)" >&2
        exit 64
    fi
done

template=$(dirname "$0")/../package/package-manifest.yaml
sed -e "s|@@RUNTIME_ROOT@@|$root|g" \
    -e "s|@@RUNTIME_REF@@|$ref|g" \
    -e "s|@@VERSION@@|$version|g" \
    -e "s|@@CREATED@@|$created|g" \
    -e "s|@@MN_SHA256@@|$MN_SHA256|g" \
    -e "s|@@JDK_LANG@@|$JDK_LANG|g" \
    -e "s|@@JDK_TEBAKO@@|$JDK_TEBAKO|g" \
    -e "s|@@JDK_EXE_SHA256@@|$JDK_EXE_SHA256|g" \
    -e "s|@@JDK_IMAGE_SHA256@@|$JDK_SHA256|g" \
    -e "s|@@X2RFC_VERSION@@|$X2RFC_VERSION|g" \
    -e "s|@@X2RFC_IMAGE_SHA256@@|$X2RFC_SHA256|g" \
    -e "s|@@PY_LANG@@|$PY_LANG|g" \
    -e "s|@@PY_TEBAKO@@|$PY_TEBAKO|g" \
    -e "s|@@PY_EXE_SHA256@@|$PY_EXE_SHA256|g" \
    -e "s|@@PY_IMAGE_SHA256@@|$PY_IMAGE_SHA256|g" \
    -e "s|@@RUNTIME_RUBY@@|$RUNTIME_RUBY|g" \
    "$template" > "$out"

# The render must be total: a surviving placeholder is a named error,
# never a silent half-render.
if grep -q '@@[A-Z_]*@@' "$out"; then
    echo "render-manifest: unsubstituted placeholder in $out" >&2
    exit 65
fi
echo "rendered $out (root=$root ref=$ref version=$version)"
